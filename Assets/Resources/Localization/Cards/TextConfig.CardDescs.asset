  textDataList:
  - id: card_0001_desc
    textList:
    - language: 0
      text: Gain {{SHIELD}} Shield.
    - language: 1
      text: "Nh\u1EADn {{SHIELD}} Khi\xEAn."
  - id: card_0002_desc
