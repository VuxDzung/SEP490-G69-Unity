    textList:
    - language: 0
      text: Deal {{DMG}} damage. Apply 2 Decay to enemy.
    - language: 1
      text: "G\xE2y {{DMG}} s\xE1t th\u01B0\u01A1ng. \xC1p d\u1EE5ng 2 Ph\xE2n H\u1EE7y
